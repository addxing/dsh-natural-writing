  "files": ["index.js", "policy.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "VERIFICATION.md", "test/*.test.js"],
  "scripts": { "test": "node --test test/*.test.js" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } }
